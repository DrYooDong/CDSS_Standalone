{
  "name": "cdss-standalone-suite",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Hệ thống Hỗ Trợ Quyết Định Lâm Sàng Độc Lập (CDSS Standalone Suite) - 9 Modules Chuyên Sâu",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run build:hub && npm run build:dengue && vite build && node scripts/postbuild.js",
    "preview": "vite preview --port 3000",
    "build:hub": "esbuild src/index.ts --bundle --outfile=cdss-hub-bundle.js --format=iife",
    "build:dengue": "esbuild dengue/dengue-ui.ts --bundle --outfile=dengue/dengue-bundle.js --format=esm && esbuild dengue/dengue-ui.ts --bundle --outfile=dengue/dengue-bundle.iife.js --format=iife --global-name=DengueBundle",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}